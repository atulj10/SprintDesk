# Template environment file - safe to commit. Copy to `.env` for local use:
#   cp .env.example .env
# The real `.env` is gitignored and must never contain committed secrets.

# Base URL for the DummyJSON authentication API
VITE_DUMMYJSON_BASE_URL=https://dummyjson.com

# Base URL for the JSONPlaceholder API (notification polling)
VITE_JSONPLACEHOLDER_BASE_URL=https://jsonplaceholder.typicode.com

# Demo login credentials - LOCAL ONLY, never commit real values.
# Public demo accounts are documented at https://dummyjson.com/docs/auth.
# (Not consumed by the app; kept in your local .env for reference.)
# VITE_DEMO_USERNAME=your-username-here
# VITE_DEMO_PASSWORD=your-password-here
